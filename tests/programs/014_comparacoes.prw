// Valida os operadores relacionais.
User Function TesteComparacoes()

    If 5 == 5
        ConOut("igual")
    EndIf

    If 5 != 3
        ConOut("diferente")
    EndIf

    If 3 < 5
        ConOut("menor")
    EndIf

    If 5 <= 5
        ConOut("menorigual")
    EndIf

    If 7 > 2
        ConOut("maior")
    EndIf

    If 7 >= 7
        ConOut("maiorigual")
    EndIf

    If "abc" == "abc"
        ConOut("strigual")
    EndIf

Return
